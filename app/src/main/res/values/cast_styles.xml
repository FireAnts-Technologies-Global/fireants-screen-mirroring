<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="cast_MediaPreviewShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/cast_media_preview_radius</item>
    </style>
    <style name="cast_text_regular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cast_textPrimary</item>
        <item name="android:gravity">start</item>
        <item name="android:fontFamily">@font/cast_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="cast_text_medium" parent="cast_text_regular">
        <item name="android:fontFamily">@font/cast_medium</item>
    </style>
    <style name="cast_text_bold" parent="cast_text_regular">
        <item name="android:fontFamily">@font/cast_bold</item>
    </style>
    <style name="cast_text_regular_12" parent="cast_text_regular">
        <item name="android:textSize">@dimen/_10sdp</item>
    </style>
    <style name="cast_text_regular_10" parent="cast_text_regular">
        <item name="android:textSize">@dimen/_8sdp</item>
    </style>
    <style name="cast_text_regular_8" parent="cast_text_regular">
        <item name="android:textSize">@dimen/_7sdp</item>
    </style>
    <style name="cast_text_medium_14" parent="cast_text_medium">
        <item name="android:textSize">@dimen/_12sdp</item>
    </style>
    <style name="cast_text_medium_12" parent="cast_text_medium">
        <item name="android:textSize">@dimen/_10sdp</item>
    </style>
    <style name="cast_text_bold_12" parent="cast_text_bold">
        <item name="android:textSize">@dimen/_10sdp</item>
    </style>
</resources>