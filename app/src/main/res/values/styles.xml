<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="text_regular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:gravity">start</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="rounded_corner">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="RoundedCorner_9">
        <item name="cornerSize">@dimen/_9sdp</item>
    </style>
    <style name="text_medium" parent="text_regular">
        <item name="android:fontFamily">@font/medium</item>
    </style>
    <style name="text_bold" parent="text_regular">
        <item name="android:fontFamily">@font/bold</item>
    </style>
    <style name="text_regular_12" parent="text_regular">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>
    <style name="text_medium_12" parent="text_medium">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>
    <style name="text_bold_16" parent="text_bold">
        <item name="android:textSize">@dimen/_16ssp</item>
    </style>
    <style name="text_bold_14" parent="text_bold">
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>
    <style name="text_bold_12" parent="text_bold">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>
    <style name="text_bold_10" parent="text_bold">
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>
    <style name="adsCtaNativeCommon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">15dp</item>
        <item name="android:layout_marginEnd">15dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/ads_native_common_cta</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="adsBackgroundNativeCommon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ads_native_common_bg</item>
    </style>
</resources>