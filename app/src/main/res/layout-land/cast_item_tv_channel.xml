<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cvContent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_55sdp"
        android:layout_marginBottom="@dimen/_7sdp"
        android:background="@drawable/cast_bg_player_channel_card"
        android:padding="@dimen/_7sdp">

        <com.genesys.shape.view.ShapeImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/cast_bg_channel_thumb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="@dimen/_7sdp"
            app:shape_solidColor="@color/cast_white" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerThumbnail"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintEnd_toEndOf="@id/ivThumbnail"
            app:layout_constraintStart_toStartOf="@id/ivThumbnail"
            app:layout_constraintTop_toTopOf="@id/ivThumbnail">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/cast_bg_channel_thumb" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/channelInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_7sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivThumbnail"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/cast_cast_primary_text"
                android:textSize="@dimen/_11sdp"
                tools:text="Football Match" />
            <FrameLayout
                android:id="@+id/btnWatchNow"
                android:layout_width="@dimen/_69sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:background="@drawable/cast_bg_channel_watch_now"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:text="@string/cast_watch_now"
                    android:textColor="@color/cast_white"
                    android:textSize="@dimen/_10sdp" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
