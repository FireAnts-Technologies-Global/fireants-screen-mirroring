<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cast_home_background">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cast_home_photo_height">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_living_room" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cast_home_photo_fade_height"
                        android:layout_gravity="bottom"
                        android:background="@drawable/cast_bg_home_photo_fade" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cast_home_content_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_37sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvConnectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/cast_home_text_primary"
                                android:textSize="@dimen/_13sdp"
                                tools:text="No TV connected" />

                            <TextView
                                android:id="@+id/tvConnectionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:fontFamily="@font/regular"
                                android:includeFontPadding="false"
                                android:textColor="#475467"
                                android:textSize="@dimen/_10sdp"
                                tools:text="Choose a device to get started" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnConnectionAction"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_37sdp"
                            android:background="@drawable/cast_bg_home_connection_action"
                            android:fontFamily="@font/inter_bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minWidth="@dimen/_71sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textColor="@color/cast_color_nav_selected"
                            android:textSize="@dimen/_12sdp"
                            tools:text="Connect" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardMirrorBanner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cast_home_mirror_height"
                        android:layout_marginTop="@dimen/cast_home_gap"
                        android:background="@drawable/cast_bg_home_mirror_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_13sdp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:includeFontPadding="false"
                                android:text="Screen Mirroring"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_15sdp" />

                            <TextView
                                android:id="@+id/tvCastBannerDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_10sdp"
                                tools:text="Share your phone screen on TV" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/home_mirror" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardHowToUse"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cast_home_tutorial_height"
                        android:layout_marginTop="@dimen/cast_home_gap"
                        android:background="@drawable/cast_bg_home_tutorial_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_10sdp">

                        <ImageView
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:background="@drawable/cast_bg_home_tutorial_icon"
                            android:contentDescription="@null"
                            android:padding="@dimen/_7sdp"
                            android:src="@drawable/home_video" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="Tutorial"
                                android:textColor="@color/cast_home_text_tutorial"
                                android:textSize="@dimen/_13sdp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false"
                                android:text="Learn how to connect and cast to your TV"
                                android:textColor="@color/cast_home_text_tutorial_secondary"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/_17sdp"
                            android:layout_height="@dimen/_17sdp"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right_figma" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cast_home_section_height"
                        android:layout_marginTop="@dimen/cast_home_gap"
                        android:background="@drawable/cast_bg_home_section"
                        android:orientation="vertical"
                        android:padding="@dimen/_7sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_15sdp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false"
                            android:text="Cast Media"
                            android:textColor="@color/cast_home_text_primary"
                            android:textSize="@dimen/_13sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/cast_home_feature_row_height"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/cardFeatureVideo"
                                layout="@layout/cast_item_home_feature"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/cardFeaturePhoto"
                                layout="@layout/cast_item_home_feature"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/_7sdp"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cast_home_section_height"
                        android:layout_marginTop="@dimen/cast_home_gap"
                        android:background="@drawable/cast_bg_home_section"
                        android:orientation="vertical"
                        android:padding="@dimen/_7sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_15sdp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false"
                            android:text="Cast Web &amp; Channels"
                            android:textColor="@color/cast_home_text_primary"
                            android:textSize="@dimen/_13sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/cast_home_feature_row_height"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/cardFeatureCast"
                                layout="@layout/cast_item_home_feature"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/cardFeatureImport"
                                layout="@layout/cast_item_home_feature"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/_7sdp"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/flAds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp">

                    <FrameLayout
                        android:id="@+id/flAdContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/shimmerAds"
                        layout="@layout/layout_shimmer_native_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
