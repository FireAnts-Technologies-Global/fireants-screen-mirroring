<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:src="@drawable/cast_ic_search_empty"
            android:contentDescription="@string/cast_no_result_found"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.3" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_no_result_found"
            android:textColor="@color/cast_white"
            android:layout_marginTop="@dimen/_13sdp"
            android:fontFamily="@font/cast_semi_bold"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/ivEmptyIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_try_adjusting_your_search"
            android:textColor="@color/cast_white"
            android:layout_marginStart="@dimen/_13sdp"
            android:fontFamily="@font/cast_regular"
            android:gravity="center"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginEnd="@dimen/_13sdp"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

