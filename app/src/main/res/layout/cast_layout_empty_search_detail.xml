<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_20sdp"
    android:paddingVertical="@dimen/_20sdp">

    <ImageView
        android:id="@+id/ivDetailEmptyIcon"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_60sdp"
        android:contentDescription="@null"
        android:src="@drawable/cast_ic_search_empty"
        app:tint="@color/cast_cast_accent" />

    <TextView
        android:id="@+id/tvDetailEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/cast_no_result_found"
        android:textColor="@color/cast_home_text_primary"
        android:textSize="@dimen/_13sdp" />

    <TextView
        android:id="@+id/tvDetailEmptySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/cast_try_adjusting_your_search"
        android:textColor="@color/cast_home_text_secondary"
        android:textSize="@dimen/_11sdp" />
</LinearLayout>
