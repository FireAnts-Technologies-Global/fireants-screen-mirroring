<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="24dp">

    <ImageView
        android:id="@+id/ivDetailEmptyIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:src="@drawable/cast_ic_search_empty"
        app:tint="@color/cast_cast_accent" />

    <TextView
        android:id="@+id/tvDetailEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/cast_no_result_found"
        android:textColor="@color/cast_home_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDetailEmptySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/cast_try_adjusting_your_search"
        android:textColor="@color/cast_home_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
