<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/cast_bg_channel_card_playlist_selector"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <com.genesys.shape.view.ShapeImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="131dp"
            android:layout_height="79dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/cast_bg_channel_thumb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/cast_white" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerThumbnail"
            android:layout_width="131dp"
            android:layout_height="79dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintEnd_toEndOf="@id/ivThumbnail"
            app:layout_constraintStart_toStartOf="@id/ivThumbnail"
            app:layout_constraintTop_toTopOf="@id/ivThumbnail">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/cast_bg_channel_thumb" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/channelInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivThumbnail"
            app:layout_constraintTop_toTopOf="@id/ivThumbnail">

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cast_poppins_medium"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/cast_white"
                android:textSize="14sp"
                tools:text="Football Match" />

            <FrameLayout
                android:id="@+id/btnWatchNow"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/cast_bg_channel_watch_now"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/cast_poppins_medium"
                    android:includeFontPadding="false"
                    android:text="@string/cast_watch_now"
                    android:textColor="@color/cast_white"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
