<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.genesys.shape.layout.ShapeConstraintLayout
        app:shape_strokeColor="@color/cast_cast_border"
        app:shape_strokeSize="1dp"
        app:shape_radius="22dp"
        app:shape_solidColor="@color/cast_cast_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <View
            android:id="@+id/out_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/creenRating"/>

        <RelativeLayout
            android:id="@+id/creenRating"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ic_close"
                android:layout_margin="16dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/cast_ic_close_2"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="5dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:src="@drawable/cast_star"
                    android:id="@+id/icon"
                    android:layout_marginTop="20dp"
                    android:layout_width="120dp"
                    android:layout_height="120dp" />

                <LinearLayout
                    android:visibility="visible"
                    android:id="@+id/layout_text_first"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cast_do_you_like_our_app"
                        android:textColor="@color/cast_home_text_primary"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/inter_bold"/>

                    <TextView
                        android:id="@+id/sub_title"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cast_if_you_like_this_app_please_rate_our_app_5_stars_in_store"
                        android:textColor="@color/cast_home_text_secondary"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter_regular"/>

                </LinearLayout>

                <TextView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:fontFamily="@font/cast_font_medium"
                    android:paddingHorizontal="5dp"
                    android:text="@string/cast_tv_start_1"
                    android:textColor="@color/cast_home_text_primary"
                    android:textSize="16sp" />

                <com.anrstudio.template.ui.component.custom.CustomRatingBar
                    android:layout_marginTop="12dp"
                    android:textColor="@color/cast_white"
                    android:layout_marginHorizontal="20dp"
                    android:id="@+id/simpleRatingBar"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"/>

            </LinearLayout>
        </RelativeLayout>
    </com.genesys.shape.layout.ShapeConstraintLayout>
</layout>
