<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.genesys.shape.layout.ShapeConstraintLayout
        app:shape_strokeColor="@color/cast_cast_border"
        app:shape_radius="@dimen/_18sdp"
        app:shape_strokeSize="@dimen/_1sdp"
        app:shape_solidColor="@color/cast_cast_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <View
            android:id="@+id/out_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/creenRating"/>

        <RelativeLayout
            android:id="@+id/creenRating"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardCornerRadius="@dimen/_8sdp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ic_close"
                android:layout_width="@dimen/_27sdp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_height="@dimen/_27sdp"
                android:layout_margin="@dimen/_13sdp"
                android:src="@drawable/cast_ic_close_2"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_4sdp"
                android:paddingBottom="@dimen/_17sdp">

                <ImageView
                    android:src="@drawable/cast_star"
                    android:id="@+id/icon"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_marginTop="@dimen/_17sdp" />

                <LinearLayout
                    android:visibility="visible"
                    android:id="@+id/layout_text_first"
                    android:layout_marginTop="@dimen/_17sdp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cast_do_you_like_our_app"
                        android:textColor="@color/cast_home_text_primary"
                        android:textSize="@dimen/_17sdp"
                        android:textAlignment="center"
                        android:fontFamily="@font/inter_bold"/>

                    <TextView
                        android:id="@+id/sub_title"
                        android:layout_marginHorizontal="@dimen/_17sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cast_if_you_like_this_app_please_rate_our_app_5_stars_in_store"
                        android:textColor="@color/cast_home_text_secondary"
                        android:textAlignment="center"
                        android:textSize="@dimen/_13sdp"
                        android:fontFamily="@font/inter_regular"/>

                </LinearLayout>

                <TextView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/_4sdp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:fontFamily="@font/cast_font_medium"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:text="@string/cast_tv_start_1"
                    android:textColor="@color/cast_home_text_primary"
                    android:textSize="@dimen/_13sdp" />

                <com.hyper.castwave.ui.component.custom.CustomRatingBar
                    android:layout_height="@dimen/_44sdp"
                    android:textColor="@color/cast_white"
                    android:layout_marginHorizontal="@dimen/_17sdp"
                    android:id="@+id/simpleRatingBar"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"/>

            </LinearLayout>
        </RelativeLayout>
    </com.genesys.shape.layout.ShapeConstraintLayout>
</layout>
