<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cast_bg_home_action_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_10sdp">

    <ImageView
        android:id="@+id/imgFeatureIcon"
        android:layout_width="@dimen/cast_home_icon_tile_size"
        android:layout_height="@dimen/cast_home_icon_tile_size"
        android:padding="@dimen/_3sdp"
        android:contentDescription="@null"
        tools:src="@drawable/cast_ic_home_feature_photo" />

    <TextView
        android:id="@+id/tvFeatureTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/cast_home_text_primary"
        android:textSize="@dimen/_10sdp"
        tools:text="Cast Photos" />

    <TextView
        android:id="@+id/tvFeatureDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_regular"
        android:textColor="#475467"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/_3sdp"
        android:visibility="gone"
        android:textSize="@dimen/_10sdp"
        tools:text="Show your photos and albums on big screens." />
</LinearLayout>
