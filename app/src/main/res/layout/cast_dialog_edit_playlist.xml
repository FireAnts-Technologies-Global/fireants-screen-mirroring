<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.genesys.shape.layout.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_17sdp"
        app:shape_radius="@dimen/_27sdp"
        app:shape_solidColor="#202020"
        app:shape_strokeSize="@dimen/_1sdp"
        app:shape_strokeColor="#525252"
        >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icClose"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:src="@drawable/cast_ic_close"
            app:tint="@color/cast_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cast_bold"
            android:text="@string/cast_edit_playlist"
            android:textAlignment="center"
            android:textColor="@color/cast_white"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPlaylistNameLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/cast_semi_bold"
            android:text="@string/cast_playlist_name"
            android:textColor="@color/cast_white"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <com.genesys.shape.layout.ShapeConstraintLayout
            android:id="@+id/inputContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:minHeight="@dimen/_40sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistNameLabel"
            app:shape_radius="@dimen/_10sdp"
            app:shape_solidColor="@android:color/transparent"
            app:shape_strokeColor="#707070"
            app:shape_strokeSize="@dimen/_1sdp">

            <com.genesys.shape.view.ShapeEditText
                android:id="@+id/etPlaylistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cast_regular"
                android:hint="@string/cast_playlist_1"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:minHeight="@dimen/_40sdp"
                android:paddingStart="@dimen/_13sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_33sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:textColor="@color/cast_white"
                android:textColorHint="#707070"
                android:textSize="@dimen/_13sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/icClearInput"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:shape_solidColor="#0AFFFFFF" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icClearInput"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="@dimen/_3sdp"
                android:src="@drawable/cast_ic_close"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.genesys.shape.layout.ShapeConstraintLayout>

        <!-- Save Button -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/_40sdp"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputContainer"
            app:shape_radius="@dimen/_42sdp"
            app:shape_solidColor="@color/cast_main_text_color">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cast_bold"
                android:text="@string/cast_save"
                android:textColor="@color/cast_black"
                android:textSize="@dimen/_15sdp" />

        </com.genesys.shape.layout.ShapeLinearLayout>
    </com.genesys.shape.layout.ShapeConstraintLayout>
</layout>

