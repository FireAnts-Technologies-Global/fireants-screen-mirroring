<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.genesys.shape.layout.ShapeRelativeLayout
            android:paddingBottom="@dimen/_20sdp"
            app:shape_radius="12dp"
            app:shape_strokeColor="@color/cast_cast_border"
            app:shape_strokeSize="1dp"

            app:shape_solidColor="@color/cast_cast_surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/cast_border_dialog"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_16sdp">

                <TextView
                    android:id="@+id/tvLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/cast_text_medium_14"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/cast_home_text_primary"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="@string/cast_sleep_timer"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tvDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/cast_text_regular_10"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/cast_home_text_secondary"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="@string/cast_sleep_timer_value"
                    app:layout_constraintTop_toBottomOf="@id/tvLabel"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnClose"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/cast_ic_close_2"
                    app:tint="@color/cast_home_text_secondary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <LinearLayout
                    android:id="@+id/layoutNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:paddingHorizontal="16sp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDes">

                    <com.genesys.shape.layout.ShapeLinearLayout
                        android:paddingVertical="14sp"
                        android:layout_marginEnd="20dp"
                        app:shape_radius="20sp"
                        app:shape_strokeSize="1dp"
                        app:shape_solidColor="@color/cast_cast_surface"
                        app:shape_strokeColor="@color/cast_cast_border"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/cast_text_bold_12"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/cast_home_text_primary"
                            android:text="@string/cast_hour"/>

                        <com.anrstudio.template.ui.component.custom.numberpicker.NumberPicker
                            android:id="@+id/npHour"
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="@dimen/_120sdp"
                            android:layout_marginTop="10dp"
                            app:np_dividerColor="#00000000"
                            app:np_dividerLength="@dimen/_24sdp"
                            app:np_formatter="%02d"
                            app:np_max="23"
                            app:np_min="0"
                            app:np_orientation="vertical"
                            app:np_textColor="@color/cast_textSecondary"
                            app:np_selectedTextColor="@color/cast_cast_accent"
                            app:np_selectedTextSize="@dimen/_20ssp"
                            app:np_textSize="@dimen/_20ssp"
                            app:np_value="8"
                            app:np_width="@dimen/_56sdp"
                            app:np_wrapSelectorWheel="true" />

                    </com.genesys.shape.layout.ShapeLinearLayout>



                    <com.genesys.shape.layout.ShapeLinearLayout
                        android:paddingVertical="14sp"
                        app:shape_radius="20sp"
                        app:shape_strokeSize="1dp"
                        app:shape_solidColor="@color/cast_cast_surface"
                        app:shape_strokeColor="@color/cast_cast_border"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/cast_text_bold_12"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/cast_home_text_primary"
                            android:text="@string/cast_minute"/>

                        <com.anrstudio.template.ui.component.custom.numberpicker.NumberPicker
                            android:id="@+id/npMinute"
                            android:layout_marginTop="10dp"
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="@dimen/_120sdp"
                            app:np_dividerColor="#00000000"
                            app:np_formatter="%02d"
                            app:np_max="59"
                            app:np_min="0"
                            app:np_dividerLength="@dimen/_24sdp"
                            app:np_orientation="vertical"
                            app:np_selectedTextColor="@color/cast_cast_accent"
                            app:np_selectedTextSize="@dimen/_20ssp"
                            app:np_textColor="@color/cast_textSecondary"
                            app:np_value="30"
                            app:np_width="@dimen/_56sdp"
                            app:np_textSize="@dimen/_20ssp"
                            app:np_wrapSelectorWheel="true" />


                    </com.genesys.shape.layout.ShapeLinearLayout>


                </LinearLayout>

                <TextView
                    android:id="@+id/btnSet"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cast_button_height_small"
                    android:text="@string/cast_set"
                    android:textColor="@color/cast_white"
                    android:background="@drawable/cast_bg_iptv_dialog_primary_action"
                    android:gravity="center"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    style="@style/cast_text_medium_12"
                    android:lines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:paddingHorizontal="@dimen/_4sdp"
                    app:layout_constraintTop_toBottomOf="@id/layoutNumber"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/btnClear"
                    style="@style/cast_text_medium_12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cast_button_height_small"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/cast_bg_dialog_secondary_action"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lines="1"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:text="@string/cast_clear"
                    android:textColor="@color/cast_home_text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layoutNumber" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.genesys.shape.layout.ShapeRelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
