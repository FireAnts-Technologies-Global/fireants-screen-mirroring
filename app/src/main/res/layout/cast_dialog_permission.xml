<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cast_bg_iptv_dialog"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <ImageView
        android:id="@+id/imgPermission"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/tvPermissionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:textColor="@color/cast_home_text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvPermissionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:textColor="@color/cast_home_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:orientation="horizontal">

        <com.hyper.castwave.ui.component.custom.GradientTextView
            android:id="@+id/btnPermissionDeny"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/cast_bg_dialog_secondary_action"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:paddingVertical="@dimen/_12sdp"
            android:textColor="@color/cast_home_text_primary"
            android:textSize="14sp" />

        <Space
            android:layout_width="@dimen/_12sdp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnPermissionAllow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/cast_bg_iptv_dialog_primary_action"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:paddingVertical="@dimen/_12sdp"
            android:textColor="@color/cast_white"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
