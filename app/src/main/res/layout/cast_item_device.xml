<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rlCast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cast_bg_cast_device_item"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/flDeviceIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/cast_bg_cast_device_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgCast"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/cast_ic_cast_tv" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/flConnectStatus"
            app:layout_constraintStart_toEndOf="@id/flDeviceIcon"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cast_poppins_semi_bold"
                android:maxLines="1"
                android:textColor="@color/cast_white"
                android:textSize="14sp"
                tools:text="Samsung S5" />

            <TextView
                android:id="@+id/tvModelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cast_poppins_regular"
                android:maxLines="1"
                android:textColor="@color/cast_color_how_to_use_step_text"
                android:textSize="12sp"
                tools:text="192.168.1.1" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flConnectStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgIsConnect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/cast_ic_cast_arrow_right" />

            <ProgressBar
                android:id="@+id/progressConnecting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminateTint="@color/cast_color_home_cast_banner_border"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
