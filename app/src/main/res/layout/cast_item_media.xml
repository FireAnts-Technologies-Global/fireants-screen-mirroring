<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/flThumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/cast_RoundedCorner20" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:fontFamily="@font/cast_poppins_medium"
            android:layout_margin="@dimen/_6sdp"
            android:background="@drawable/cast_bg_duration_badge"
            android:paddingHorizontal="6dp"
            android:paddingTop="2dp"
            android:paddingVertical="2dp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_9sdp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgPlay"
            android:layout_gravity="center"
            android:src="@drawable/cast_ic_play"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"/>

        <View
            android:id="@+id/viewCastingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cast_bg_overlay"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgCastingIcon"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="center"
            android:src="@drawable/cast_ic_cast"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        android:textColor="@color/cast_color_263238"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flThumbnail" />

</androidx.constraintlayout.widget.ConstraintLayout>
