<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/flThumbnail"
        android:layout_width="0dp"
        android:layout_height="@dimen/_93sdp"
        app:layout_constraintDimensionRatio="H,101:112"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/cast_MediaTileShape" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_19sdp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_7sdp"
            android:background="@drawable/cast_bg_media_duration"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:paddingStart="@dimen/_7sdp"
            android:paddingEnd="@dimen/_7sdp"
            android:textColor="@color/cast_cast_surface"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgPlay"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center"
            android:background="@drawable/cast_bg_media_play"
            android:padding="@dimen/_11sdp"
            android:src="@drawable/cast_ic_play"
            android:visibility="gone" />

        <View
            android:id="@+id/viewCastingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cast_bg_overlay"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgCastingIcon"
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:layout_gravity="center"
            android:src="@drawable/cast_ic_cast"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/_3sdp"
        android:textColor="@color/cast_cast_primary_text"
        android:textSize="@dimen/_9sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flThumbnail" />
</androidx.constraintlayout.widget.ConstraintLayout>
