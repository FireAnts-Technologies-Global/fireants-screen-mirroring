<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="@dimen/_3sdp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgTabIcon"
        android:layout_width="@dimen/_17sdp"
        android:layout_height="@dimen/_17sdp"
        android:contentDescription="@null"
        tools:src="@drawable/cast_ic_tab_home_selected" />

    <com.hyper.castwave.ui.component.custom.GradientTextView
        android:id="@+id/tvTabLabelGradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/_3sdp"
        android:singleLine="true"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        tools:text="Home"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvTabLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/cast_color_tab_inactive"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        tools:text="Channels"
        tools:visibility="visible" />

    <View
        android:id="@+id/viewTabIndicator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/cast_bg_tab_indicator_selected"
        android:visibility="gone" />
</LinearLayout>
