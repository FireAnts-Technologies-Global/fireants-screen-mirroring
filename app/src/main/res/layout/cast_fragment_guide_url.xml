<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cast_bg_home_screen"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_13sdp"
            android:paddingTop="@dimen/_20sdp"
            android:paddingEnd="@dimen/_13sdp"
            android:paddingBottom="@dimen/_20sdp">

            <!-- Step 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step1Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/cast_bg_guide_step_card"
                android:padding="@dimen/_10sdp"
                >

                <FrameLayout
                    android:id="@+id/step1Number"
                    android:layout_width="@dimen/_23sdp"
                    android:layout_height="@dimen/_23sdp"
                    android:background="@drawable/cast_bg_guide_step_badge"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep1Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:text="1"
                        android:textColor="@color/cast_cast_accent"
                        android:textSize="@dimen/_12sdp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:text="@string/cast_guide_url_new_step1_text"
                    android:textColor="@color/cast_home_text_primary"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/step1Number"
                    app:layout_constraintTop_toTopOf="@id/step1Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Step 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step2Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/step1Container"
                android:background="@drawable/cast_bg_guide_step_card"
                android:padding="@dimen/_10sdp"
                >

                <FrameLayout
                    android:id="@+id/step2Number"
                    android:layout_width="@dimen/_23sdp"
                    android:layout_height="@dimen/_23sdp"
                    android:background="@drawable/cast_bg_guide_step_badge"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep2Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:text="2"
                        android:textColor="@color/cast_cast_accent"
                        android:textSize="@dimen/_12sdp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:text="@string/cast_guide_url_new_step2_text"
                    android:textColor="@color/cast_home_text_primary"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/step2Number"
                    app:layout_constraintTop_toTopOf="@id/step2Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Step 3 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step3Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/step2Container"
                android:background="@drawable/cast_bg_guide_step_card"
                android:padding="@dimen/_10sdp"
                >

                <FrameLayout
                    android:id="@+id/step3Number"
                    android:layout_width="@dimen/_23sdp"
                    android:layout_height="@dimen/_23sdp"
                    android:background="@drawable/cast_bg_guide_step_badge"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep3Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:text="3"
                        android:textColor="@color/cast_cast_accent"
                        android:textSize="@dimen/_12sdp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:text="@string/cast_guide_url_new_step3_text"
                    android:textColor="@color/cast_home_text_primary"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/step3Number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/step3Number"
                    app:layout_constraintTop_toTopOf="@id/step3Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Step 4 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step4Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/step3Container"
                android:background="@drawable/cast_bg_guide_step_card"
                android:padding="@dimen/_10sdp"
                >

                <FrameLayout
                    android:id="@+id/step4Number"
                    android:layout_width="@dimen/_23sdp"
                    android:layout_height="@dimen/_23sdp"
                    android:background="@drawable/cast_bg_guide_step_badge"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep4Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:text="4"
                        android:textColor="@color/cast_cast_accent"
                        android:textSize="@dimen/_12sdp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:text="@string/cast_guide_url_new_step4_text"
                    android:textColor="@color/cast_home_text_primary"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/step4Number"
                    app:layout_constraintTop_toTopOf="@id/step4Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Search Bar -->
            <com.genesys.shape.layout.ShapeLinearLayout
                app:layout_constraintTop_toBottomOf="@+id/step4Container"
                app:shape_strokeColor="@color/cast_cast_border"
                android:layout_marginBottom="@dimen/_13sdp"
                android:paddingStart="@dimen/_13sdp"
                app:shape_solidColor="@color/cast_cast_surface"
                android:orientation="horizontal"
                android:gravity="center"
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_48sdp"
                android:paddingTop="@dimen/_13sdp"
                android:background="@drawable/cast_bg_guide_search_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="@dimen/_13sdp"
                android:paddingBottom="@dimen/_13sdp"
                app:shape_radius="@dimen/_10sdp"
                app:shape_strokeSize="@dimen/_1sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSearchIcon"
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/cast_ic_search"
                    android:tint="@color/cast_cast_accent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSearchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:fontFamily="@font/cast_medium"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/cast_guide_url_new_search_placeholder"
                    android:textColor="@color/cast_cast_accent"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivSearchIcon"
                    app:layout_constraintTop_toTopOf="parent" />
            </com.genesys.shape.layout.ShapeLinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
