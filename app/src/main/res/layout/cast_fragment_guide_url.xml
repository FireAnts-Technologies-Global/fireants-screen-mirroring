<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cast_nav_bar_bg"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Step 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step1Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@+id/step1Number"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/cast_bg_step_number"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep1Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/cast_semi_bold"
                        android:text="1"
                        android:textColor="@color/cast_black"
                        android:textSize="14sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/cast_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cast_guide_url_new_step1_text"
                    android:textColor="@color/cast_white"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/step1Number"
                    app:layout_constraintTop_toTopOf="@id/step1Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Step 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step2Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/step1Container">

                <FrameLayout
                    android:id="@+id/step2Number"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/cast_bg_step_number"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep2Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/cast_semi_bold"
                        android:text="2"
                        android:textColor="@color/cast_black"
                        android:textSize="14sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/cast_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cast_guide_url_new_step2_text"
                    android:textColor="@color/cast_white"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/step2Number"
                    app:layout_constraintTop_toTopOf="@id/step2Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Step 3 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step3Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/step2Container">

                <FrameLayout
                    android:id="@+id/step3Number"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/cast_bg_step_number"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep3Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/cast_semi_bold"
                        android:text="3"
                        android:textColor="@color/cast_black"
                        android:textSize="14sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/cast_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cast_guide_url_new_step3_text"
                    android:textColor="@color/cast_white"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@+id/step3Number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/step3Number"
                    app:layout_constraintTop_toTopOf="@id/step3Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Step 4 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step4Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/step3Container">

                <FrameLayout
                    android:id="@+id/step4Number"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/cast_bg_step_number"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvStep4Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/cast_semi_bold"
                        android:text="4"
                        android:textColor="@color/cast_black"
                        android:textSize="14sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStep4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/cast_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cast_guide_url_new_step4_text"
                    android:textColor="@color/cast_white"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/step4Number"
                    app:layout_constraintTop_toTopOf="@id/step4Number" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Search Bar -->
            <com.genesys.shape.layout.ShapeLinearLayout
                app:layout_constraintTop_toBottomOf="@+id/step4Container"
                app:shape_strokeColor="#36E4A2"
                app:shape_strokeSize="1dp"
                app:shape_radius="@dimen/_60sdp"
                app:shape_solidColor="#1A36E4A2"
                android:orientation="horizontal"
                android:gravity="center"
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_48sdp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/cast_bg_guide_search_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSearchIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/cast_ic_search"
                    android:tint="@color/cast_nav_item_selected_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSearchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/cast_medium"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/cast_guide_url_new_search_placeholder"
                    android:textColor="@color/cast_nav_item_selected_text"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivSearchIcon"
                    app:layout_constraintTop_toTopOf="parent" />
            </com.genesys.shape.layout.ShapeLinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
