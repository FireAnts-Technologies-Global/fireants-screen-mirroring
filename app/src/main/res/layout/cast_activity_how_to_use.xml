<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cast_how_to_use_background">

        <com.hyper.castwave.ui.component.custom.FigmaTopBarView
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_39sdp"
            app:figmaTopBarBackDescription="@string/cast_how_to_use_guide_back"
            app:figmaTopBarBackStyle="howToUse"
            app:figmaTopBarTitle="@string/cast_how_to_use_title"
            app:figmaTopBarVariant="centered"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_13sdp"
            android:paddingTop="@dimen/_13sdp"
            android:paddingBottom="@dimen/_13sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/quickStartBanner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_110sdp"
                    android:background="@drawable/cast_how_to_use_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_13sdp">

                    <LinearLayout
                        android:layout_width="@dimen/_153sdp"
                        android:layout_height="@dimen/_83sdp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_13sdp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false"
                            android:text="@string/cast_how_to_use_guide_quick_start"
                            android:textColor="@color/cast_white"
                            android:textSize="@dimen/_10sdp" />

                        <TextView
                            android:layout_width="@dimen/_153sdp"
                            android:layout_height="@dimen/_45sdp"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="0dp"
                            android:text="@string/cast_how_to_use_guide_from_phone_to_tv"
                            android:textColor="@color/cast_white"
                            android:textSize="@dimen/_18sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_13sdp"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="@string/cast_how_to_use_guide_caption"
                            android:textColor="@color/cast_white"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/_83sdp"
                        android:layout_height="@dimen/_73sdp"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cast_how_to_use_phone_to_tv" />
                </LinearLayout>

                <include
                    android:id="@+id/step1"
                    layout="@layout/cast_item_how_to_use_step"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_90sdp"
                    android:layout_marginTop="@dimen/_10sdp" />

                <include
                    android:id="@+id/step2"
                    layout="@layout/cast_item_how_to_use_step"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_73sdp"
                    android:layout_marginTop="@dimen/_10sdp" />

                <include
                    android:id="@+id/step3"
                    layout="@layout/cast_item_how_to_use_step"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_73sdp"
                    android:layout_marginTop="@dimen/_10sdp" />

                <FrameLayout
                    android:id="@+id/flAds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <FrameLayout
                        android:id="@+id/flAdContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/shimmerAds"
                        layout="@layout/layout_shimmer_native_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
