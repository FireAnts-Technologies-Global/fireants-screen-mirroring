<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cast_bg_cast_screen"
        android:fitsSystemWindows="true">

        <FrameLayout
            android:id="@+id/frAdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <include layout="@layout/cast_layout_banner_control" />
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/frAdsBanner"
            app:layout_constraintTop_toTopOf="parent">

            <com.hyper.castwave.ui.component.custom.FigmaTopBarView
                android:id="@+id/toolbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:figmaTopBarTitle="@string/cast_cast_title"
                app:figmaTopBarVariant="centeredActions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toolbar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_13sdp"
                    android:paddingTop="@dimen/_13sdp"
                    android:paddingBottom="@dimen/_13sdp">

                    <!-- Searching and empty/error content share one card position. -->
                    <FrameLayout
                        android:id="@+id/clCast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:id="@+id/searchStatusCard"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/cast_cast_status_height"
                            android:background="@drawable/cast_bg_cast_status">

                            <FrameLayout
                                android:layout_width="@dimen/cast_cast_signal_size"
                                android:layout_height="@dimen/cast_cast_signal_size"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:background="@drawable/cast_bg_cast_signal">

                                <ImageView
                                    android:id="@+id/imgSearching"
                                    android:layout_width="@dimen/_70sdp"
                                    android:layout_height="@dimen/_70sdp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/cast_img_state_searching" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvSearchingTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_113sdp"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/cast_cast_searching_devices"
                                android:textColor="@color/cast_cast_primary_text"
                                android:textSize="@dimen/cast_cast_text_16" />

                            <TextView
                                android:id="@+id/tvSearchingSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_136sdp"
                                android:fontFamily="@font/inter_regular"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="@dimen/_2sdp"
                                android:maxLines="2"
                                android:text="@string/cast_title_br1"
                                android:textColor="@color/cast_cast_secondary_text"
                                android:textSize="@dimen/cast_cast_text_12" />
                        </FrameLayout>

                        <!-- This overlay is shown by the existing Empty/LostConnection states. -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/emptyDeviceContainer"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_218sdp"
                            android:background="@android:color/transparent"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:id="@+id/imgNoDevice"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="@dimen/_60sdp"
                                android:layout_marginTop="@dimen/_28sdp"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cast_img_state_no_device"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvTitleError"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_113sdp"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/cast_no_device_available"
                                android:textColor="@color/cast_cast_primary_text"
                                android:textSize="@dimen/cast_cast_text_16"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvMessageError"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_136sdp"
                                android:fontFamily="@font/inter_regular"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="@dimen/_2sdp"
                                android:maxLines="2"
                                android:text="@string/cast_please_check_your_wifi_connection_devices"
                                android:textColor="@color/cast_cast_secondary_text"
                                android:textSize="@dimen/cast_cast_text_12"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <FrameLayout
                                android:id="@+id/tvActionError"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_41sdp"
                                android:layout_marginTop="@dimen/_178sdp"
                                android:background="@drawable/cast_bg_cast_action"
                                android:clickable="true"
                                android:focusable="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/tvActionErrorLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/inter_bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/cast_refresh"
                                    android:textColor="@color/cast_white"
                                    android:textSize="@dimen/_12sdp" />
                            </FrameLayout>

                            <!-- Kept for the existing settings callback; not shown in the selected states. -->
                            <FrameLayout
                                android:id="@+id/btnOpenWirelessDisplay"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_41sdp"
                                android:layout_marginTop="@dimen/_225sdp"
                                android:background="@drawable/cast_bg_cast_action"
                                android:clickable="true"
                                android:focusable="true"
                                android:visibility="gone"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="@string/cast_open_wireless_display"
                                    android:textColor="@color/cast_white"
                                    android:textSize="@dimen/_12sdp" />
                            </FrameLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:fontFamily="@font/inter_bold"
                        android:includeFontPadding="false"
                        android:text="@string/cast_cast_available_devices"
                        android:textColor="@color/cast_cast_secondary_text"
                        android:textSize="@dimen/_11sdp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone"
                        tools:itemCount="3"
                        tools:listitem="@layout/cast_item_device"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvAlternativeConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:fontFamily="@font/inter_bold"
                        android:includeFontPadding="false"
                        android:text="@string/cast_cast_alternative_connection"
                        android:textColor="@color/cast_cast_secondary_text"
                        android:textSize="@dimen/_11sdp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rlBrowserCast"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_58sdp"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:background="@drawable/cast_bg_cast_device"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/_7sdp">

                        <FrameLayout
                            android:id="@+id/flWebIcon"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:background="@drawable/cast_bg_cast_device_icon_tile"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/cast_ic_figma_browser" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/imgWebArrow"
                            app:layout_constraintStart_toEndOf="@id/flWebIcon"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:includeFontPadding="false"
                                android:text="@string/cast_web_browser"
                                android:textColor="@color/cast_cast_primary_text"
                                android:textSize="@dimen/_12sdp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false"
                                android:text="@string/cast_cast_web_browser_subtitle"
                                android:textColor="@color/cast_cast_secondary_text"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgWebArrow"
                            android:layout_width="@dimen/_13sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/cast_ic_figma_chevron"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
