<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.genesys.shape.layout.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_17sdp"
        android:background="@drawable/cast_bg_iptv_dialog"
        app:shape_radius="@dimen/_18sdp"
        app:shape_solidColor="@color/cast_cast_surface"
        app:shape_strokeSize="@dimen/_1sdp"
        app:shape_strokeColor="@color/cast_cast_border"
        >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icClose"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:src="@drawable/cast_ic_close"
            android:tint="@color/cast_home_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/cast_edit_channel"
            android:textAlignment="center"
            android:textColor="@color/cast_home_text_primary"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPlaylistNameLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/cast_channel_name"
            android:textColor="@color/cast_home_text_primary"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <com.genesys.shape.layout.ShapeConstraintLayout
            android:id="@+id/inputContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:minHeight="@dimen/_40sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistNameLabel"
            app:shape_radius="@dimen/_10sdp"
            app:shape_solidColor="@android:color/transparent"
            app:shape_strokeColor="@color/cast_cast_border"
            app:shape_strokeSize="@dimen/_1sdp">

            <com.genesys.shape.view.ShapeEditText
                android:id="@+id/etChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_regular"
                android:hint="@string/cast_playlist_1"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:minHeight="@dimen/_40sdp"
                android:paddingStart="@dimen/_13sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_33sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:textColor="@color/cast_home_text_primary"
                android:textColorHint="@color/cast_home_text_secondary"
                android:textSize="@dimen/_13sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/icClearInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_solidColor="@color/cast_cast_surface" />

            <ImageView
                android:id="@+id/icClearInput"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="@dimen/_3sdp"
                android:src="@drawable/cast_ic_close"
                app:tint="@color/cast_home_text_secondary"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.genesys.shape.layout.ShapeConstraintLayout>

        <!-- Save Button -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/_40sdp"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputContainer"
            app:shape_radius="@dimen/_10sdp"
            app:shape_solidColor="@color/cast_cast_accent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/cast_save"
                android:textColor="@color/cast_white"
                android:textSize="@dimen/_15sdp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

    </com.genesys.shape.layout.ShapeConstraintLayout>

</layout>

