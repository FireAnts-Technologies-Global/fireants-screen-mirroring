<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView" android:layout_width="0dp" android:layout_height="0dp"
            android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never"
            android:paddingHorizontal="16dp" android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvPlaylistNameLabel" android:layout_width="match_parent" android:layout_height="16dp"
                    android:fontFamily="@font/inter_bold" android:includeFontPadding="false" android:text="@string/cast_name"
                    android:textColor="@color/cast_home_text_primary" android:textSize="13sp" />
                <FrameLayout android:id="@+id/containerPlaylistName" android:layout_width="match_parent" android:layout_height="50dp"
                    android:layout_marginTop="12dp" android:background="@drawable/cast_bg_import_input" android:paddingHorizontal="16dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlaylistName"
                        android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent"
                        android:fontFamily="@font/inter_regular" android:gravity="center_vertical" android:hint="@string/cast_enter_playlist_name_hint"
                        android:includeFontPadding="false" android:inputType="text" android:maxLines="1" android:padding="0dp"
                        android:textColor="@color/cast_home_text_primary" android:textColorHint="@color/cast_color_tab_inactive" android:textSize="13sp" />
                    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/icClearPlaylistName" android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical" android:clickable="true" android:focusable="true" android:padding="2dp"
                        android:src="@drawable/cast_ic_close" android:visibility="gone" app:tint="@color/cast_home_text_secondary" />
                </FrameLayout>
                <TextView android:id="@+id/tvPlaylistUrlLabel" android:layout_width="match_parent" android:layout_height="16dp"
                    android:layout_marginTop="12dp" android:fontFamily="@font/inter_bold" android:includeFontPadding="false"
                    android:text="@string/cast_playlist_link" android:textColor="@color/cast_home_text_primary" android:textSize="13sp" />
                <FrameLayout android:id="@+id/containerPlaylistUrl" android:layout_width="match_parent" android:layout_height="50dp"
                    android:layout_marginTop="12dp" android:background="@drawable/cast_bg_import_input" android:paddingHorizontal="16dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlaylistUrl"
                        android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent"
                        android:fontFamily="@font/inter_regular" android:gravity="center_vertical" android:hint="@string/cast_paste_url_here"
                        android:includeFontPadding="false" android:inputType="textUri" android:maxLines="1" android:padding="0dp"
                        android:textColor="@color/cast_home_text_primary" android:textColorHint="@color/cast_color_tab_inactive" android:textSize="13sp" />
                    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/icClearPlaylistUrl" android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical" android:clickable="true" android:focusable="true" android:padding="2dp"
                        android:src="@drawable/cast_ic_close" android:visibility="gone" app:tint="@color/cast_home_text_secondary" />
                </FrameLayout>
                <FrameLayout android:id="@+id/btnAddPlaylist" android:layout_width="match_parent" android:layout_height="49dp"
                    android:layout_marginTop="12dp" android:background="@drawable/cast_bg_import_primary" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center"
                        android:gravity="center" android:orientation="horizontal">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@null" android:src="@drawable/cast_ic_add_figma" app:tint="@color/cast_white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_bold" android:includeFontPadding="false" android:text="@string/cast_add_playlist"
                            android:textColor="@color/cast_white" android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <include android:id="@+id/layoutLoading" layout="@layout/cast_layout_loading" android:layout_width="0dp" android:layout_height="0dp"
            android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
