<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_17sdp"
        android:background="@drawable/cast_bg_iptv_dialog"
        app:shape_radius="@dimen/_13sdp"
        app:shape_solidColor="@color/cast_cast_surface">
        <TextView
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_delete_channel"
            android:textColor="@color/cast_home_text_primary"
            android:textSize="@dimen/_15sdp"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:textAlignment="center"
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cast_do_you_want_to_delete_this_channel"
            android:textColor="@color/cast_home_text_secondary"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/inter_regular"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/tvMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cast_cancel"
                android:textColor="@color/cast_home_text_secondary"
                android:paddingStart="@dimen/_17sdp"
                android:fontFamily="@font/inter_semibold"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_17sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:textSize="@dimen/_12sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_13sdp"
                android:text="@string/cast_delete"
                android:background="@drawable/cast_bg_dialog_delete_action"
                android:textColor="@color/cast_white"
                android:paddingStart="@dimen/_17sdp"
                android:fontFamily="@font/inter_semibold"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_17sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:textSize="@dimen/_12sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

