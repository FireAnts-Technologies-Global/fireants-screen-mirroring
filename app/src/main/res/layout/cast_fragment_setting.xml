<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cast_settings_background">

        <com.hyper.castwave.ui.component.custom.FigmaTopBarView
            android:id="@+id/tvSettingsHeader"
            android:layout_width="0dp"
            android:layout_height="@dimen/_33sdp"
            android:layout_marginTop="@dimen/_41sdp"
            app:figmaTopBarTitle="@string/cast_home_screen_mirroring"
            app:figmaTopBarVariant="compactTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/settingItems"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_13sdp"
            android:paddingTop="@dimen/_13sdp"
            android:paddingBottom="@dimen/_13sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSettingsHeader">

            <include
                android:id="@+id/layout_setting_language"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_55sdp"
                android:tag="language" />

            <include
                android:id="@+id/layout_setting_privacy"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:tag="privacy" />

            <include
                android:id="@+id/layout_setting_rate"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:tag="rate" />

            <include
                android:id="@+id/layout_setting_share"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:tag="share" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
