<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cast_settings_background">

        <TextView
            android:id="@+id/tvSettingsHeader"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="49dp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/cast_home_screen_mirroring"
            android:textColor="@color/cast_settings_text_primary"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/settingItems"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSettingsHeader">

            <include
                android:id="@+id/layout_setting_language"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:tag="language" />

            <include
                android:id="@+id/layout_setting_privacy"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="12dp"
                android:tag="privacy" />

            <include
                android:id="@+id/layout_setting_rate"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="12dp"
                android:tag="rate" />

            <include
                android:id="@+id/layout_setting_share"
                layout="@layout/cast_item_setting_option"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="12dp"
                android:tag="share" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
