<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="279dp"
        android:background="@drawable/cast_bg_channel_empty_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:background="@drawable/cast_bg_channels_empty_ring">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/cast_img_channels_empty_figma" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="23dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/cast_channels_empty_title"
            android:textColor="@color/cast_home_text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/cast_channels_empty_subtitle"
            android:textColor="@color/cast_home_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/btnAddChannel"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/cast_bg_channel_add_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/cast_ic_add_figma"
                android:tint="@color/cast_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
        android:text="@string/cast_channels_add_action"
                android:textColor="@color/cast_white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</layout>
