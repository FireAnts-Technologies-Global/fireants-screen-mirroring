<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/cast_bg_media"
    android:gravity="center">

    <TextView
        android:id="@+id/btnVideo"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/_4sdp"
        android:gravity="center"
        android:fontFamily="@font/cast_poppins_regular"
        android:text="@string/cast_video"
        android:textSize="@dimen/_11sdp"
        android:textColor="@color/cast_white" />

    <TextView
        android:id="@+id/btnImage"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/_4sdp"
        android:gravity="center"
        android:text="@string/cast_image"
        android:textSize="@dimen/_11sdp"
        android:fontFamily="@font/cast_poppins_regular"
        android:textColor="@color/cast_white" />

    <TextView
        android:id="@+id/btnAudio"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/_4sdp"
        android:gravity="center"
        android:text="@string/cast_audio"
        android:textSize="@dimen/_11sdp"
        android:fontFamily="@font/cast_poppins_regular"
        android:textColor="@color/cast_white" />

</LinearLayout>
