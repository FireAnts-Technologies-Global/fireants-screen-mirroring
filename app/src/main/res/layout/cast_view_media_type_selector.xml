<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/cast_bg_media_nav"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView android:id="@+id/btnImage" style="@style/cast_MediaTab" android:text="@string/cast_media_photos" />
    <TextView android:id="@+id/btnVideo" style="@style/cast_MediaTab" android:text="@string/cast_media_videos" />
    <TextView android:id="@+id/btnRecent" style="@style/cast_MediaTab" android:text="@string/cast_media_recent" />
    <TextView android:id="@+id/btnFavorite" style="@style/cast_MediaTab" android:text="@string/cast_media_favorites" />
    <TextView android:id="@+id/btnPortrait" style="@style/cast_MediaTab" android:text="@string/cast_media_portrait" />
    <TextView
        android:id="@+id/btnAudio"
        style="@style/cast_MediaTab"
        android:text="@string/cast_audio"
        android:visibility="gone" />
</LinearLayout>
