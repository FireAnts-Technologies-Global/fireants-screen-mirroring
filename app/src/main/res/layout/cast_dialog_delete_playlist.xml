<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.genesys.shape.layout.ShapeConstraintLayout
        android:padding="@dimen/_20sdp"
        app:shape_strokeColor="#525252"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:shape_radius="@dimen/_27sdp"
        app:shape_strokeSize="@dimen/_1sdp"
        app:shape_solidColor="#202020">
        <TextView
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_delete_playlist"
            android:textColor="@color/cast_white"
            android:textSize="@dimen/_15sdp"
            android:fontFamily="@font/cast_semi_bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:textAlignment="center"
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cast_do_you_want_to_delete_this_playlist"
            android:textColor="#B3B3B3"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/cast_regular"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="@dimen/_15sdp"
            app:layout_constraintTop_toBottomOf="@id/tvMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.genesys.shape.view.ShapeTextView
                app:shape_radius="@dimen/_30sdp"
                app:shape_solidColor="#282828"
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/cast_cancel"
                android:textAlignment="center"
                android:textColor="#B3B3B3"
                android:paddingStart="@dimen/_17sdp"
                android:fontFamily="@font/cast_bold"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_17sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:textSize="@dimen/_12sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

            <com.genesys.shape.view.ShapeTextView
                app:shape_radius="@dimen/_30sdp"
                app:shape_solidColor="#36E4A2"
                android:textAlignment="center"
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_13sdp"
                android:text="@string/cast_delete"
                android:textColor="@color/cast_black"
                android:paddingStart="@dimen/_17sdp"
                android:fontFamily="@font/cast_bold"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_17sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:textSize="@dimen/_12sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

        </LinearLayout>

    </com.genesys.shape.layout.ShapeConstraintLayout>

</layout>

