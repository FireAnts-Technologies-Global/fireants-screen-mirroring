<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cast_bg_pin_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgPinArtwork"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/cast_img_pin_verification" />

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/cast_pin_dialog_title"
        android:textColor="@color/cast_cast_primary_text"
        android:textSize="19sp"
        tools:text="Enter verification code" />

    <TextView
        android:id="@+id/tvPinSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/cast_cast_secondary_text"
        android:textSize="13sp"
        tools:text="Enter the code shown on your TV." />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/cast_bg_pin_dialog_input_empty"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_vertical"
        android:hint="@string/cast_pin_code_hint"
        android:imeOptions="actionDone"
        android:includeFontPadding="false"
        android:inputType="number"
        android:importantForAutofill="no"
        android:maxLength="6"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/cast_cast_input_text"
        android:textColorHint="@color/cast_cast_secondary_text"
        android:textSize="15sp"
        tools:ignore="TextFields" />

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/cast_color_error"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Please enter the PIN"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/dialogActions"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPinCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/cast_bg_pin_dialog_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/cast_pin_dialog_cancel"
            android:textColor="@color/cast_cast_button_secondary_text"
            android:textSize="14sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnPinConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/cast_bg_pin_dialog_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/cast_pin_dialog_confirm"
            android:textColor="@color/cast_cast_input_text"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
