<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Empty Icon -->
        <ImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:src="@drawable/cast_ic_search_not_found"
            android:contentDescription="@string/cast_channels_empty_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.3" />

        <!-- Main Message -->
        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_no_channels_available"
            android:textColor="@color/cast_white"
            android:layout_marginTop="@dimen/_13sdp"
            android:fontFamily="@font/cast_semi_bold"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/ivEmptyIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Secondary Message -->
        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_import_playlist_to_discover_new_channels"
            android:textColor="@color/cast_white"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/cast_regular"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Add Channel Button -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/btnAddChannel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/_20sdp"
            android:paddingStart="@dimen/_17sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_17sdp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            app:shape_solidColor="@color/cast_main_text_color"
            android:paddingBottom="@dimen/_8sdp"
            app:shape_radius="@dimen/_43sdp"
            app:layout_constraintTop_toBottomOf="@id/tvEmptySubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <ImageView
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/cast_ic_add"
                android:contentDescription="@string/cast_channels_add_action" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cast_add_channel"
                android:textColor="@color/cast_white"
                android:layout_marginStart="@dimen/_7sdp"
                android:fontFamily="@font/cast_semi_bold"
                android:textSize="@dimen/_12sdp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

