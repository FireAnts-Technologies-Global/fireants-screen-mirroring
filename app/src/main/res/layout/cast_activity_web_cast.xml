<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cast_bg_home_screen"
        android:fitsSystemWindows="true">

        <com.hyper.castwave.ui.component.custom.FigmaTopBarView
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:figmaTopBarTitle="@string/cast_web_browser"
            app:figmaTopBarVariant="centered"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_13sdp"
            android:paddingBottom="@dimen/_20sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/img_anim_loading"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/cast_screen_mirroring" />

                <LinearLayout
                    android:id="@+id/lnContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/cast_bg_webcast_step_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_13sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <TextView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:background="@drawable/cast_bg_webcast_step_badge"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/cast_one"
                            android:textColor="@color/cast_cast_accent"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="@dimen/_2sdp"
                            android:text="@string/cast_title_br1"
                            android:textColor="@color/cast_home_text_primary"
                            android:textSize="@dimen/_12sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/cast_bg_webcast_step_card"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_13sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:background="@drawable/cast_bg_webcast_step_badge"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/cast_two"
                                android:textColor="@color/cast_cast_accent"
                                android:textSize="@dimen/_12sdp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="@dimen/_2sdp"
                                android:text="@string/cast_open_this"
                                android:textColor="@color/cast_home_text_primary"
                                android:textSize="@dimen/_12sdp" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_28sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:background="@drawable/cast_bg_import_input"
                            android:minHeight="@dimen/_43sdp"
                            android:paddingHorizontal="@dimen/_13sdp"
                            android:paddingVertical="@dimen/_12sdp">

                            <TextView
                                android:id="@+id/tv_ip_wifi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:textColor="@color/cast_home_text_primary"
                                android:textSize="@dimen/_12sdp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/cast_bg_webcast_step_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_13sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <TextView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:background="@drawable/cast_bg_webcast_step_badge"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/cast_three"
                            android:textColor="@color/cast_cast_accent"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="@dimen/_2sdp"
                            android:text="@string/cast_click_on"
                            android:textColor="@color/cast_home_text_primary"
                            android:textSize="@dimen/_12sdp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/tvStartScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/cast_bg_import_add_playlist_enabled"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/_43sdp"
                    android:paddingHorizontal="@dimen/_17sdp"
                    android:paddingVertical="@dimen/_13sdp">

                    <TextView
                        android:id="@+id/tvStartScreenLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/cast_screen_mirror_start"
                        android:textColor="@color/cast_white"
                        android:textSize="@dimen/_13sdp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvConnectedDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/cast_home_text_secondary"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
