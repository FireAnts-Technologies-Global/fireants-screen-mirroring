<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cast_how_to_use_card_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp">

        <LinearLayout
            android:id="@+id/stepMarker"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_46sdp"
            android:background="@drawable/cast_how_to_use_step_tile"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivStepIcon"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/cast_how_to_use_icon_wifi" />

            <TextView
                android:id="@+id/tvStepNumber"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/cast_settings_accent"
                android:textSize="@dimen/_10sdp"
                tools:text="01" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stepCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_15sdp"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/cast_settings_text_primary"
                android:textSize="@dimen/_13sdp"
                tools:text="Connect to your TV" />

            <TextView
                android:id="@+id/tvStepDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_6sdp"
                android:textColor="@color/cast_settings_text_secondary"
                android:textSize="@dimen/_11sdp"
                tools:text="Use the same Wi-Fi on both devices. Select your TV and enter the code if prompted." />
        </LinearLayout>
    </LinearLayout>
</layout>
