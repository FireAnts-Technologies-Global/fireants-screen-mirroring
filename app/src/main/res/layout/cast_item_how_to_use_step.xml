<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cast_bg_how_to_use_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStepNumber"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/cast_bg_how_to_use_step_badge"
                android:fontFamily="@font/cast_poppins_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/cast_white"
                android:textSize="14sp"
                tools:text="1" />

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/cast_poppins_semi_bold"
                android:textColor="@color/cast_white"
                android:textSize="14sp"
                tools:text="Hook up to your TV!" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStepDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cast_poppins_regular"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/cast_color_how_to_use_step_text"
            android:textSize="14sp"
            tools:text="Just make sure your TV and phone are on the same Wi-Fi." />
    </LinearLayout>
</layout>
