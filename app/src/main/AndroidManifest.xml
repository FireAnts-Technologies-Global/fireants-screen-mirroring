<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.hyper.castwave.app.GlobalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Main"
        android:usesCleartextTraffic="true"
        tools:replace="android:dataExtractionRules,android:fullBackupContent,android:networkSecurityConfig">

        <activity
            android:name=".ui.component.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.hyper.castwave.ui.component.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="LockedOrientationActivity">


        </activity>

        <activity
            android:name="com.hyper.castwave.ui.component.language.LanguageActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name="com.hyper.castwave.ui.component.onboarding.OnBoardingActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".ui.component.setting.SettingActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".ui.component.welcome.WelcomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name="com.hyper.castwave.ui.component.howtouse.HowToUseActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.cast.CastActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.iptv.addchannel.AddChannelActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.iptv.player.PlayListActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="true"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.iptv.channel.all.AllChannelActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.iptv.guide.GuideActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.media.MediaPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.webcast.WebCastActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.webbrowser.WebBrowserActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <activity
            android:name="com.hyper.castwave.ui.component.videocontrol.VideoControlActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/cast_Base.Theme.CastToTV" />

        <service
            android:name="com.hyper.castwave.casting.service.CastForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|mediaProjection" />

        <service
            android:name="com.hyper.castwave.data.screenmirror.ScreenRecorder"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${app_id}" />

        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="true" />

        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />

        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.hyper.castwave.casting.CastOptionsProvider" />

    </application>

</manifest>
